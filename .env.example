# ─── Plataforma ──────────────────────────────────────────────────────────────
# Dominio raíz (con puerto en desarrollo). Cada club vive en {slug}.<ROOT_DOMAIN>.
# En desarrollo usá lvh.me (resuelve a 127.0.0.1 y permite cookies compartidas
# entre subdominios): http://lvh.me:3000 y http://rionorte.lvh.me:3000
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000
NEXT_PUBLIC_PLATFORM_NAME=Tropa

# ─── Supabase ────────────────────────────────────────────────────────────────
# `pnpm db:start` imprime estos valores para el entorno local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (worker de push, jobs). Nunca la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generalas con: pnpm vapid:generate
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@tropa.app

# ─── Jobs ────────────────────────────────────────────────────────────────────
# Secreto compartido con pg_cron (Vault: cron_secret) y Vercel Cron.
CRON_SECRET=

# ─── Tests de RLS ────────────────────────────────────────────────────────────
# Opcional: por defecto apuntan a la base de `supabase start`.
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Cobros de la plataforma (Fase 3) ────────────────────────────────────────
# mercadopago | fake. Por defecto: mercadopago si hay MP_ACCESS_TOKEN; si no, fake (solo fuera de producción).
BILLING_PROVIDER=
# Mercado Pago → Tus integraciones → Credenciales de producción (Access Token)
MP_ACCESS_TOKEN=
# Mercado Pago → Webhooks → "Clave secreta" (para validar x-signature)
MP_WEBHOOK_SECRET=
# Proveedor simulado (desarrollo/E2E). Por defecto usa CRON_SECRET.
FAKE_BILLING_SECRET=
# ALLOW_FAKE_BILLING=1   # habilita el simulado en producción (solo para demos)

# ─── Relojes (Fase 3) ────────────────────────────────────────────────────────
# Garmin Connect Developer Program (requiere aprobación como partner)
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Opcionales: sobrescriben los endpoints si Garmin los informa distintos
# GARMIN_AUTHORIZE_URL= GARMIN_TOKEN_URL= GARMIN_WORKOUT_URL= GARMIN_SCHEDULE_URL=
# ALLOW_FAKE_WATCH=1     # habilita el reloj simulado en producción (solo para demos)
